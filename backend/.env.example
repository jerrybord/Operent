# === RentYourClaw Backend ===

# Telegram Bot (основной бот RentYourClaw для WebApp)
TG_BOT_TOKEN=
TG_BOT_SECRET=  # sha256 HMAC key for validating initData

# Server
PORT=3000
HOST=0.0.0.0

# Database
DB_PATH=./data/rentyourclaw.db

# LLM Proxy — твой API ключ (прокси для всех юзеров)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Usage limits (tokens per user per day)
DAILY_TOKEN_LIMIT=50000
MONTHLY_TOKEN_LIMIT=1000000

# Agent VPS Pool (comma-separated)
# Format: ip:port:user:password
VPS_POOL=

# Deploy settings
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest

# CryptoBot (Crypto Pay API)
CRYPTOBOT_TOKEN=

# Blockchain explorer API keys (free tier works without, but rate-limited)
ETHERSCAN_API_KEY=
BSCSCAN_API_KEY=
ARBISCAN_API_KEY=

# Blockchain scanner (set 'true' to disable in local dev)
DISABLE_SCANNER=false
