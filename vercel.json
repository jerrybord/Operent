{
  "name": "operent",
  "buildCommand": null,
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "http://193.58.121.157:3000/api/:path*" },
    { "source": "/v1/:path*", "destination": "http://193.58.121.157:3000/v1/:path*" }
  ]
}
